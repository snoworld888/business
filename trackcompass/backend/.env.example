# ============================================================
# TrackCompass 后端配置（复制为 .env 后按需修改）
# ============================================================

# ---------- 基础 ----------
APP_NAME=赛道罗盘 TrackCompass
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1

# ---------- 安全 ----------
# 生产环境务必替换为随机 64 位字符串
SECRET_KEY=trackcompass-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------- 存储 ----------
# 留空 => SQLite（零依赖，开箱即用）
# 生产 PostgreSQL 16：
# DATABASE_URL=postgresql+psycopg://trackcompass:password@127.0.0.1:5432/trackcompass
DATABASE_URL=
SQLITE_PATH=

# ---------- 认知层适配器 ----------
# memory（默认，零依赖） | milvus
VECTOR_BACKEND=memory
MILVUS_URI=http://localhost:19530

# memory（默认，NetworkX） | neo4j
GRAPH_BACKEND=memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# local（确定性哈希，离线可复现，默认） | openai | ollama
EMBEDDING_BACKEND=local

# 维度口径：
#   local / openai 用 EMBEDDING_DIM
#   ollama 按模型自动识别（bge-m3 = 1024），此处数值对其不生效
EMBEDDING_DIM=1536

# ⚠️ 两个模型名体系不同，不可混用：
#   EMBEDDING_MODEL        —— HuggingFace / OpenAI 兼容接口名（带组织前缀）
#   EMBEDDING_OLLAMA_MODEL —— Ollama 仓库名（无前缀）
# 向 Ollama 传 "BAAI/bge-m3" 会直接报 model not found
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_OLLAMA_MODEL=bge-m3

# ---------- LLM ----------
# rule（默认，离线规则引擎，无需 API Key） | openai（兼容 Qwen/DeepSeek/vLLM） | ollama
LLM_PROVIDER=rule
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_SIMPLE=Qwen2.5-7B
LLM_MODEL_COMPLEX=gpt-4o
LLM_MODEL_PRIVATE=Qwen2.5-72B
LLM_CACHE_TTL_HOURS=24
LLM_TIMEOUT_SECONDS=60

# ---------- 功能开关 ----------
ENABLE_MONITOR_SCHEDULER=false
ENABLE_LLM_REPORT_POLISH=false

# ---------- 前端托管 ----------
# true = 后端在 / 直接托管 frontend/dist，单端口同时服务 UI 与 API
#        需先执行 cd frontend && npm run build
# false = 仅提供 API，前端另起 Vite dev server（npm run dev）
SERVE_FRONTEND=true
# FRONTEND_DIST=../frontend/dist

# ---------- RAG（检索增强） ----------
# memory  = 自建：进程内向量 + BM25 + RRF（零依赖、亚毫秒、可断言）
# ragflow = 外部 RAGFlow 服务（真语义嵌入、文档级切块；需要 API Key 与 dataset）
# 默认值已是 ragflow（全量替换）；未配置或不可达时会**自动降级 memory 并告警**。
RAG_BACKEND=ragflow
RAGFLOW_BASE_URL=http://localhost:9380
# 从 RAGFlow UI (http://localhost:8060) → 右上角头像 → API 获取
RAGFLOW_API_KEY=
# 专用知识库 id；用脚本一键创建：
#   python scripts/check_ragflow.py --ensure-dataset trackcompass-signals
RAGFLOW_DATASET_ID=
RAGFLOW_TIMEOUT_SECONDS=30
RAGFLOW_SIMILARITY_THRESHOLD=0.2
RAGFLOW_VECTOR_WEIGHT=0.3
# 上传后等待异步解析的最长秒数（超时仅告警，文档稍后可检索）
RAGFLOW_PARSE_WAIT_SECONDS=90

# 是否让 RAGFlow 用大模型抽取关键词后再检索（可提升短查询召回）。
# ⚠️ 开启前提：该租户的**默认对话模型**（MySQL: rag_flow.tenant.llm_id）
#    必须已登记在 tenant_llm 中；否则 RAGFlow 会抛
#    `LookupError: Tenant Model ... type chat not found`，导致**整条检索失败**。
#    默认 false —— 只用向量 + BM25，不依赖任何对话模型。
RAGFLOW_KEYWORD_EXTRACTION=false

# 接入自查：
#   python scripts/check_ragflow.py --list-datasets
#   python scripts/check_ragflow.py --ensure-dataset trackcompass-signals
#   python scripts/check_ragflow.py --dataset-id <id> --smoke
# 注意：RAGFlow 的 document 名 = signal_id，用于把检索结果映射回证据链。

# ---------- 接入本地 Ollama 示例（本机已有 qwen3.8:27b / bge-m3） ----------
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL_COMPLEX=qwen3.8:27b
# LLM_MODEL_SIMPLE=qwen2.5:7b
# EMBEDDING_BACKEND=ollama
# EMBEDDING_OLLAMA_MODEL=bge-m3      # 注意是 Ollama 仓库名，不是 BAAI/bge-m3
# 注意：本机 Ollama 仅监听 IPv6 ::，请使用 localhost 而非 127.0.0.1
# 注意：切换嵌入后端会使既有向量失效（维度不同不可比），需 POST /api/v1/signals/reindex 重建
# 注意：Ollama 需 OLLAMA_MAX_LOADED_MODELS>=2，否则嵌入与对话模型互相驱逐
